# Database (MySQL / MariaDB) — the single connection source for the app,
# Prisma CLI (migrations) and prisma/seed.ts. Special characters in the
# password must be percent-encoded (e.g. @ → %40).
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Auth — generate with: openssl rand -hex 32
AUTH_SECRET=""

# App URL (used for verification links etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seeded admin credentials (used by prisma/seed.ts only)
SEED_ADMIN_EMAIL="admin@kcsgmart.in"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_NAME="KCS Admin"
AUTH_TRUST_HOST="true"

# Canonical site URL used for SEO metadata (OG image resolution, canonical links)
NEXT_PUBLIC_SITE_URL="https://kcsgmart.in"

# ── WhatsApp OTP (FueledInbox API) ──────────────────────────────────────
# Used for phone verification at signup. Get credentials from
# FueledInbox → Settings → API Keys (needs messages:send scope).
# WACRM_BASE_URL="https://your-wacrm-domain.example.com"
# WACRM_API_KEY="wacrm_live_your_api_key"
# WACRM_OTP_TEMPLATE_ID=""
#
# Local development without FueledInbox credentials: OTPs are logged to the
# server console and echoed in the UI. NEVER enable in real deployments.
# ALLOW_DEV_OTP="true"

WACRM_BASE_URL="https://whatsapp.digitalfueled.com"
WACRM_OTP_TEMPLATE_ID="test_template"
WACRM_API_KEY="wacrm_live_0df9f24b415449c66eddd7de8d7a82c55aa575fe67ea241c"