// KCS G-Mart — Prisma schema (MySQL)
// Corporate gifting e-commerce platform: catalog, tiered bulk pricing,
// orders, content (blogs), enquiries, bookings and auth (Auth.js JWT sessions).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// SINGLE  — one flat price, MOQ 1, no slab table
/// BULK    — tiered slabs with a minimum order quantity
/// ENQUIRY — no public price, "Request a quote" only
enum PricingMode {
  SINGLE
  BULK
  ENQUIRY
}

/// How variants are priced: SHARED = product tiers ± a per-variant adjustment,
/// CUSTOM = every variant carries its own tier table.
enum VariantPricing {
  SHARED
  CUSTOM
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  firstName         String
  lastName          String
  email             String    @unique
  passwordHash      String
  phone             String?
  role              Role      @default(CUSTOMER)
  emailVerifiedAt   DateTime?
  verificationToken String?   @unique

  // Company details (B2B)
  companyName String?
  gstNo       String?
  panNo       String?

  // Billing address
  billingAddress  String?
  billingCity     String?
  billingState    String?
  billingPincode  String?
  billingCountry  String?

  // Shipping address
  shippingAddress String?
  shippingCity    String?
  shippingState   String?
  shippingPincode String?
  shippingCountry String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders         Order[]
  reviews        Review[]
  wishlistItems  WishlistItem[]
}

/// Per-user wishlist ("gifting ideas"). Strictly scoped to the owning user —
/// every query filters by the authenticated user's id.
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  image     String?
  parentId  Int?
  isSpecial Boolean  @default(false)
  sortOrder Int      @default(0)
  /// SEO overrides — storefront metadata falls back to the category title.
  metaTitle       String? @db.VarChar(70)
  metaDescription String? @db.VarChar(165)
  metaKeywords    String? @db.VarChar(255)
  ogImage         String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]  @relation("CategoryTree")
  products ProductCategory[]

  @@index([parentId])
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  logo      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  sku         String?  @unique
  introtext   String?
  description String?  @db.Text
  image       String
  video       String?
  delivery    String?
  stock       Int      @default(0)
  /// How the product is sold: single-unit price, bulk slabs, or enquiry only.
  pricingMode PricingMode @default(BULK)
  /// Denormalised first price tier — powers listing sort/filter without joins.
  basePrice   Decimal  @default(0) @db.Decimal(10, 2)
  baseMrp     Decimal  @default(0) @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  isNew       Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  isBestSeller Boolean @default(false)
  brandId     Int?
  /// SEO overrides — storefront metadata falls back to name/introtext/image.
  metaTitle       String? @db.VarChar(70)
  metaDescription String? @db.VarChar(165)
  metaKeywords    String? @db.VarChar(255)
  ogImage         String?
  /// Tax: HSN/SAC code and GST rate (%) — listed prices are GST-inclusive.
  hsnCode     String?  @db.VarChar(10)
  gstRate     Decimal  @default(18) @db.Decimal(4, 2)
  /// Shipping: packed weight (grams) and box dimensions (cm) for rate calculation.
  weightGrams Int      @default(0)
  lengthCm    Decimal  @default(0) @db.Decimal(7, 2)
  widthCm     Decimal  @default(0) @db.Decimal(7, 2)
  heightCm    Decimal  @default(0) @db.Decimal(7, 2)
  /// True when the product is sold in colour/size variants.
  hasVariants Boolean  @default(false)
  variantPricing VariantPricing @default(SHARED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand      Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  prices     ProductPrice[]
  specs      ProductSpec[]
  categories ProductCategory[]
  reviews    Review[]
  wishlistedBy WishlistItem[]
  orderItems OrderItem[]
  options    ProductOption[]
  variants   ProductVariant[]

  @@index([brandId])
  @@index([isActive])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  sortOrder Int      @default(0)
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// Tiered bulk pricing, e.g. 10+ units @ ₹249, 50+ units @ ₹229
model ProductPrice {
  id          Int                @id @default(autoincrement())
  minQuantity Int
  price       Decimal @db.Decimal(10, 2)
  mrp         Decimal @db.Decimal(10, 2)
  productId   String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, minQuantity])
}

model ProductSpec {
  id        Int     @id @default(autoincrement())
  label     String
  value     String
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// An option axis such as "Colour" or "Size" with its ordered values.
model ProductOption {
  id        Int    @id @default(autoincrement())
  productId String
  name      String @db.VarChar(40)
  /// Ordered list of values, e.g. ["S","M","L"] — stored as JSON for simplicity.
  values    Json
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
}

/// One sellable combination (e.g. Red / L) with its own SKU, stock, image,
/// price tiers and shipping weight.
model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  /// Option values keyed by option name, e.g. {"Colour":"Red","Size":"L"}.
  attributes Json
  /// Stable label built from the attribute values ("Red / L").
  label      String  @db.VarChar(120)
  sku        String? @unique
  image      String?
  stock      Int     @default(0)
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)
  /// Denormalised first tier for quick display.
  basePrice  Decimal @default(0) @db.Decimal(10, 2)
  baseMrp    Decimal @default(0) @db.Decimal(10, 2)
  /// Shared pricing: rupees added to every product tier for this variant (may be negative).
  priceDelta Decimal @default(0) @db.Decimal(10, 2)
  /// Optional shipping overrides — fall back to the product values when 0/null.
  weightGrams Int?
  lengthCm    Decimal? @db.Decimal(7, 2)
  widthCm     Decimal? @db.Decimal(7, 2)
  heightCm    Decimal? @db.Decimal(7, 2)

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices     VariantPrice[]
  orderItems OrderItem[]

  @@index([productId])
}

model VariantPrice {
  id          Int     @id @default(autoincrement())
  variantId   String
  minQuantity Int
  price       Decimal @db.Decimal(10, 2)
  mrp         Decimal @db.Decimal(10, 2)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, minQuantity])
}

model ProductCategory {
  productId  String
  categoryId Int

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Review {
  id         Int      @id @default(autoincrement())
  productId  String
  userId     String?
  authorName String
  rating     Int
  title      String?
  comment    String   @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([isApproved])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  userId       String?
  status       OrderStatus @default(PENDING)

  // Customer snapshot
  customerName  String
  customerEmail String
  customerPhone String
  companyName   String?
  gstNo         String?

  // Billing snapshot
  billingAddress  String
  billingCity     String
  billingState    String
  billingPincode  String
  billingCountry  String  @default("India")

  // Shipping snapshot
  shippingAddress String
  shippingCity    String
  shippingState   String
  shippingPincode String
  shippingCountry String  @default("India")

  subtotal Decimal         @db.Decimal(12, 2)
  shipping Decimal         @db.Decimal(12, 2) @default(0)
  total    Decimal         @db.Decimal(12, 2)
  notes    String?         @db.Text

  // Tax snapshot (prices are GST-inclusive; tax is carved out for the invoice)
  taxableAmount Decimal @default(0) @db.Decimal(12, 2)
  cgst          Decimal @default(0) @db.Decimal(12, 2)
  sgst          Decimal @default(0) @db.Decimal(12, 2)
  igst          Decimal @default(0) @db.Decimal(12, 2)
  /// Place of supply state code (first two digits of GSTIN, e.g. "07" for Delhi).
  placeOfSupply String? @db.VarChar(2)

  // Shipping calculation snapshot
  shippingZone     String? @db.VarChar(40)
  chargeableWeight Int     @default(0)
  shippingMethod   String? @db.VarChar(60)

  // Invoice
  invoiceNumber String?   @unique
  invoicedAt    DateTime?

  // Shipment / courier
  courierName    String?   @db.VarChar(80)
  trackingNumber String?   @db.VarChar(80)
  trackingUrl    String?   @db.VarChar(500)
  shippedAt      DateTime?
  expectedAt     DateTime?
  deliveredAt    DateTime?
  shipmentNote   String?   @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  variantId String?
  name      String
  /// Variant label snapshot, e.g. "Red / L".
  variantLabel String? @db.VarChar(120)
  sku       String? @db.VarChar(60)
  image     String?
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int
  lineTotal Decimal @db.Decimal(12, 2)
  hsnCode   String? @db.VarChar(10)
  gstRate   Decimal @default(18) @db.Decimal(4, 2)
  /// Tax carved out of lineTotal (inclusive pricing).
  taxAmount Decimal @default(0) @db.Decimal(12, 2)
  weightGrams Int   @default(0)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}

/// Shipping zones — a delivery state maps to exactly one zone. Rates are
/// weight slabs per zone; the highest matching `uptoGrams` slab applies,
/// and `perExtra500g` covers anything above the largest slab.
model ShippingZone {
  id        Int     @id @default(autoincrement())
  code      String  @unique @db.VarChar(40)
  name      String  @db.VarChar(80)
  /// State names (as entered at checkout) covered by this zone.
  states    Json
  /// Estimated delivery window shown to customers.
  etaDays   String  @db.VarChar(20) @default("3-5")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  rates ShippingRate[]
}

model ShippingRate {
  id        Int     @id @default(autoincrement())
  zoneId    Int
  uptoGrams Int
  price     Decimal @db.Decimal(10, 2)

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, uptoGrams])
}

/// Single-row store settings (id = 1): free-shipping threshold, seller GST details.
model StoreSetting {
  id                    Int     @id @default(1)
  freeShippingThreshold Decimal @default(1000) @db.Decimal(10, 2)
  /// Price per extra 500 g beyond the last slab, per zone code → amount (JSON).
  extraPer500g          Json?
  /// Volumetric divisor (cm³ per kg); couriers commonly use 5000.
  volumetricDivisor     Int     @default(5000)
  sellerName            String  @default("KCS G-Mart") @db.VarChar(120)
  sellerGstin           String? @db.VarChar(15)
  sellerPan             String? @db.VarChar(10)
  sellerAddress         String? @db.VarChar(300)
  sellerStateCode       String  @default("07") @db.VarChar(2)
  sellerEmail           String? @db.VarChar(120)
  sellerPhone           String? @db.VarChar(20)
  invoicePrefix         String  @default("KCS/INV") @db.VarChar(20)
  invoiceCounter        Int     @default(0)
  updatedAt             DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model BlogPost {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  excerpt     String    @db.VarChar(500)
  content     String    @db.Text
  image       String
  author      String    @default("KCS G-Mart Team")
  isPublished Boolean   @default(true)
  publishedAt DateTime  @default(now())
  /// SEO overrides — storefront metadata falls back to title/excerpt/image.
  metaTitle       String? @db.VarChar(70)
  metaDescription String? @db.VarChar(165)
  metaKeywords    String? @db.VarChar(255)
  ogImage         String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished])
}

// ---------------------------------------------------------------------------
// Leads & engagement
// ---------------------------------------------------------------------------

model BulkEnquiry {
  id          Int           @id @default(autoincrement())
  name        String
  email       String
  phone       String
  companyName String?
  productId   String?
  productName String?
  quantity    Int?
  message     String        @db.Text
  status      EnquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model MeetingBooking {
  id        Int           @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  company   String?
  date      DateTime
  timeSlot  String
  notes     String?       @db.Text
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([date])
  @@index([status])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}
